tenant_name: Tenant_Tenant_DMZ
bridge_domains:
- bd_name: BD-210
  vrf_name: VRF_dmz_Web
  enable_routing: false
  l2_unknown_unicast: flood
  arp_flooding: true
- bd_name: BD-220
  vrf_name: VRF_dmz_Data
  enable_routing: false
  l2_unknown_unicast: flood
  arp_flooding: true
- bd_name: BD-230
  vrf_name: VRF_dmz_Web
  enable_routing: false
  l2_unknown_unicast: flood
  arp_flooding: true
- bd_name: BD-240
  vrf_name: VRF_dmz_Web
  enable_routing: false
  l2_unknown_unicast: flood
