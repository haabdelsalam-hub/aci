- epg_name: BareMetal_VPC_Access_DMZ
  bd_name: BD-230
  ap_name: AP_Web_Stack
  vrf_name: VRF_dmz_Web
  vmware_domains: []
  nutanix_domains: []
  physical_domains:
  - BareMetal_Rack1_PhysDom
  static_bindings:
