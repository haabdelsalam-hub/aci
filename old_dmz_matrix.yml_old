    description: Server 3 trunk on eth1/3 of both leaves
    state: present
  - enabled: true
    encap_id: 210
    deploy_immediacy: immediate
    interface_mode: trunk
    interface_type: vpc
    pod_id: 1
    leafs:
    - '101'
    - '102'
